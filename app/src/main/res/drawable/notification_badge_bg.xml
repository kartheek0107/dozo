<?xml version="1.0" encoding="utf-8"?>
<!-- Premium notification badge with gradient and stroke -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:startColor="#EF4444"
        android:endColor="#B91C1C"
        android:angle="135"
        android:type="linear" />
    <stroke
        android:width="2dp"
        android:color="#FFFFFF" />
    <size
        android:width="20dp"
        android:height="20dp" />
</shape>
